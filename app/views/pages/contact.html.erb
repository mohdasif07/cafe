<% content_for :title, "Contact | Cozy Cafe — Cadillac, MI" %>
<% content_for :meta_description, "Contact Cozy Cafe at 8834 E 34 Rd, Cadillac, MI 49601. Call +1 (568) 828-9017 or send a message." %>

<section class="page-hero">
  <div class="container" data-reveal>
    <p class="eyebrow">GET IN TOUCH</p>
    <h1 class="page-hero__title">Visit Cozy Cafe</h1>
    <p class="page-hero__text">
      We’d love to welcome you — stop by, call, or send us a note.
    </p>
  </div>
</section>

<section class="section section--cream">
  <div class="container contact-layout">
    <div class="contact-info" data-reveal>
      <h2 class="section-title">COZY CAFE</h2>
      <ul class="contact-details contact-details--page">
        <li class="contact-details__item">
          <span class="contact-details__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z"/>
              <circle cx="12" cy="10" r="2.5"/>
            </svg>
          </span>
          <address class="contact-info__address">
            <%= ApplicationHelper::SITE_ADDRESS_LINE1 %><br>
            <%= ApplicationHelper::SITE_ADDRESS_LINE2 %><br>
            <%= ApplicationHelper::SITE_ADDRESS_LINE3 %>
          </address>
        </li>
        <li class="contact-details__item">
          <span class="contact-details__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M6.5 4.5h3l1.2 4.2-1.8 1.1a12.5 12.5 0 0 0 5.3 5.3l1.1-1.8 4.2 1.2v3a1.5 1.5 0 0 1-1.6 1.5A15.5 15.5 0 0 1 5 6.1a1.5 1.5 0 0 1 1.5-1.6Z" stroke-linejoin="round"/>
            </svg>
          </span>
          <a href="<%= ApplicationHelper::SITE_PHONE_HREF %>"><%= ApplicationHelper::SITE_PHONE %></a>
        </li>
      </ul>
      <div class="contact-info__hours">
        <h3>Opening Hours</h3>
        <p class="placeholder-note">Placeholder — confirm hours with the café</p>
        <ul>
          <li>Mon–Fri: 7:00 AM – 7:00 PM</li>
          <li>Sat–Sun: 8:00 AM – 6:00 PM</li>
        </ul>
      </div>
      <div class="contact-info__social">
        <h3>Social</h3>
        <%= render "shared/social_links" %>
      </div>
    </div>

    <div class="contact-form-wrap" data-reveal data-controller="contact-form">
      <h2 class="section-title">Send a Message</h2>
      <%= form_with url: contact_path, method: :post, local: true, html: { class: "contact-form", novalidate: true, data: { action: "contact-form#validate" } } do %>
        <div class="form-field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required autocomplete="name" value="<%= @name %>" data-contact-form-target="name">
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" value="<%= @email %>" data-contact-form-target="email">
        </div>
        <div class="form-field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" value="<%= @phone %>" data-contact-form-target="phone">
        </div>
        <div class="form-field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required data-contact-form-target="message"><%= @message %></textarea>
        </div>
        <p class="form-error" data-contact-form-target="error" hidden></p>
        <button type="submit" class="btn btn--accent">Submit</button>
      <% end %>
    </div>
  </div>
</section>

<section class="map-section">
  <div class="container" data-reveal>
    <h2 class="section-title">Find Us</h2>
    <div class="map-frame">
      <iframe
        title="Map showing Cozy Cafe location in Cadillac, MI"
        src="<%= maps_embed_url %>"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </div>
</section>
