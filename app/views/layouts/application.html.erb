<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= page_description %>">
    <meta name="theme-color" content="#1a1210">
    <link rel="canonical" href="<%= request.original_url.split('?').first %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= ApplicationHelper::SITE_NAME %>">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= request.original_url.split('?').first %>">
    <meta property="og:image" content="<%= cafe_image(:hero) %>">
    <meta property="og:locale" content="en_US">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= cafe_image(:hero) %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <script type="application/ld+json">
      <%= structured_data_json %>
    </script>
  </head>

  <body class="site-body <%= "is-home" if controller_name == "pages" && action_name == "home" %>" data-controller="nav reveal lightbox">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <%= render "shared/header" %>

    <% if flash[:notice].present? %>
      <div class="flash flash--notice" role="status"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="flash flash--alert" role="alert"><%= flash[:alert] %></div>
    <% end %>

    <main id="main-content">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/lightbox" %>
  </body>
</html>
