<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <p class="site-footer__name">COZY CAFE</p>
      <p class="site-footer__tagline"><%= ApplicationHelper::SITE_TAGLINE %></p>
      <p class="site-footer__blurb">A cozy place for great coffee, delicious food and good company.</p>
    </div>

    <div>
      <h2 class="site-footer__heading">Quick Links</h2>
      <ul class="site-footer__links">
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "About", about_path %></li>
        <li><%= link_to "Menu", menu_path %></li>
        <li><%= link_to "Gallery", gallery_path %></li>
        <li><%= link_to "Contact", contact_path %></li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Contact</h2>
      <ul class="contact-details">
        <li class="contact-details__item">
          <span class="contact-details__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M12 21s7-5.2 7-11a7 7 0 1 0-14 0c0 5.8 7 11 7 11z"/>
              <circle cx="12" cy="10" r="2.5"/>
            </svg>
          </span>
          <address class="site-footer__address">
            <%= ApplicationHelper::SITE_ADDRESS_LINE1 %><br>
            <%= ApplicationHelper::SITE_ADDRESS_LINE2 %><br>
            <%= ApplicationHelper::SITE_ADDRESS_LINE3 %>
          </address>
        </li>
        <li class="contact-details__item">
          <span class="contact-details__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M6.5 4.5h3l1.2 4.2-1.8 1.1a12.5 12.5 0 0 0 5.3 5.3l1.1-1.8 4.2 1.2v3a1.5 1.5 0 0 1-1.6 1.5A15.5 15.5 0 0 1 5 6.1a1.5 1.5 0 0 1 1.5-1.6Z" stroke-linejoin="round"/>
            </svg>
          </span>
          <a href="<%= ApplicationHelper::SITE_PHONE_HREF %>"><%= ApplicationHelper::SITE_PHONE %></a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="site-footer__heading">Follow Us</h2>
      <%= render "shared/social_links" %>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p>&copy; 2026 Cozy Cafe. All rights reserved.</p>
      <p class="site-footer__legal">
        <%= link_to "Privacy Policy", privacy_path %>
        <span aria-hidden="true">·</span>
        <%= link_to "Terms & Conditions", terms_path %>
      </p>
    </div>
  </div>
</footer>
